  "mt-jeconias": {
   "name": {
    "pt": "Jeconias (Joaquim)",
    "en": "Jechoniah (Jehoiachin)"
   },
   "personId": "joaquim",
   "branch": "mt",
   "note": {
    "pt": "Mateus 1:11 passa de Josias a Jeconias e não cita Jeoaquim, filho de Josias e pai de Jeconias (2Rs 23:34; 24:6). “Seus irmãos” aparece no mesmo versículo.",
    "en": "Matthew 1:11 goes from Josiah to Jechoniah and does not name Jehoiakim, Josiah’s son and Jechoniah’s father (2 Kings 23:34; 24:6). “His brothers” appears in the same verse."
   }
  },
  "mt-salatiel": {
   "name": {
    "pt": "Salatiel (Sealtiel)",
    "en": "Shealtiel"
   },
   "branch": "mt",
   "note": {
    "pt": "Esdras 3:2 e Ageu 1:1 chamam Zorobabel “filho de Salatiel”, mas 1Crônicas 3:19 o dá como filho de Pedaías, irmão de Salatiel. Jeremias 22:30 fala de Jeconias como “sem filhos”; como isso se concilia com Mateus 1:12 é debatido.",
    "en": "Ezra 3:2 and Haggai 1:1 call Zerubbabel “son of Shealtiel,” but 1 Chronicles 3:19 gives him as a son of Pedaiah, Shealtiel’s brother. Jeremiah 22:30 speaks of Jechoniah as “childless”; how this fits with Matthew 1:12 is debated."
   }
