  "mt-jeconias": {
   "name": {
    "pt": "Jeconias (Joaquim)",
    "en": "Jechoniah (Jehoiachin)"
   },
   "personId": "joaquim",
   "branch": "mt",
   "note": {
    "pt": "Mateus 1:11 passa de Josias a Jeconias e não cita Jeoaquim, filho de Josias e pai de Jeconias (2Rs 23:34; 24:6). “Seus irmãos” aparece no mesmo versículo.",
    "en": "Matthew 1:11 goes from Josiah to Jechoniah and does not name Jehoiakim, Josiah’s son and Jechoniah’s father (2 Kings 23:34; 24:6). “His brothers” appears in the same verse."
   }
  },
  "mt-salatiel": {
   "name": {
    "pt": "Salatiel (Sealtiel)",
    "en": "Shealtiel"
   },
   "branch": "mt",
   "note": {
    "pt": "Mateus e Lucas coincidem em Salatiel e Zorobabel, mas dão pais diferentes a Salatiel (aqui, Jeconias; em Lucas 3:27, Neri). As explicações propostas são um casamento por levirato, a herança por duas linhas ou dois homens com o mesmo nome; o texto não decide. Jeremias 22:30 fala de Jeconias como “sem filhos” e entra na discussão.",
    "en": "Matthew and Luke agree on Shealtiel and Zerubbabel, but give Shealtiel different fathers (here, Jechoniah; in Luke 3:27, Neri). Proposed explanations are a levirate marriage, inheritance through two lines, or two men with the same name; the text does not decide. Jeremiah 22:30 speaks of Jechoniah as “childless” and enters the discussion."
   }
  },
  "mt-zorobabel": {
   "name": {
    "pt": "Zorobabel",
    "en": "Zerubbabel"
   },
   "personId": "zorobabel",
   "branch": "mt",
   "note": {
    "pt": "Esdras 3:2 e Ageu 1:1 chamam Zorobabel “filho de Salatiel”, mas 1Crônicas 3:19 o dá como filho de Pedaías, irmão de Salatiel. Os nomes dos filhos de Zorobabel em 1Crônicas 3:19–20 também não incluem Abiúde.",
    "en": "Ezra 3:2 and Haggai 1:1 call Zerubbabel “son of Shealtiel,” but 1 Chronicles 3:19 gives him as a son of Pedaiah, Shealtiel’s brother. The names of Zerubbabel’s sons in 1 Chronicles 3:19–20 also do not include Abiud."
   }
